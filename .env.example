BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
DRY_RUN=true
LIVE_TRADING_ENABLED=false
# Mock / paper only: seeds the local account snapshot. Live/testnet capital comes from Binance USD-M account state.
TOTAL_CAPITAL=1000
TAKE_PROFIT_PCT=0.45
STOP_LOSS_PCT=0.08
ENABLE_TAKE_PROFIT=true
ENABLE_STOP_LOSS=false
LEVERAGE=1
MAX_ACTIVE_SIGNAL_POOLS=2
PRICE_POLL_INTERVAL_SECONDS=5
ALLOW_SIGNAL_QUEUE=false
EXCHANGE_MODE=mock
HEARTBEAT_WEBHOOK=
ALERT_WEBHOOK=
POLL_INTERVAL_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=60
MATCH_KEYWORDS_PERPETUAL=perpetual contract,perpetual,futures,usd-m
MATCH_KEYWORDS_DELIST=delist,will delist,remove,removed,cease support
DEFAULT_SHORT_USD_AMOUNT=100
CONTRACT_CACHE_TTL_SECONDS=300
ANNOUNCEMENT_PAGE_SIZE=20
ANNOUNCEMENT_MAX_PAGES=3
STATE_FILE=state/state.json
TRADING_DB_FILE=state/trading.sqlite3
LOG_FILE=logs/monitor.log
